<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Сумма заказа -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сумма заказа:"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/etSum"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="#F8BBD0"
            android:hint="Введите сумму"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>

    <!-- Количество блюд -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Количество блюд:"
            android:textSize="16sp"/>

        <EditText
            android:id="@+id/etCount"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="#F8BBD0"
            android:hint="Например, 4"
            android:inputType="number"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>

    <!-- Чаевые -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Чаевые:"
        android:textSize="16sp"
        android:layout_marginTop="24dp"/>

    <SeekBar
        android:id="@+id/seekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="25"
        android:progress="0"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:textSize="18sp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="25"
            android:textSize="18sp"/>
    </LinearLayout>

<!--    Скидка-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Скидка:"
        android:textSize="18sp"
        android:layout_marginTop="10dp"/>

    <RadioGroup
        android:id="@+id/rgDiscount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginLeft="30dp">

        <RadioButton
            android:id="@+id/rg3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3%"
            android:enabled="false"
            android:textSize="20dp"
            android:textColor="@color/black"
            />

        <RadioButton
            android:id="@+id/rg5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5%"
            android:enabled="false"
            android:textSize="20dp"
            android:textColor="@color/black"
            />

        <RadioButton
            android:id="@+id/rg7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7%"
            android:enabled="false"
            android:textSize="20dp"
            android:textColor="@color/black"
            />

        <RadioButton
            android:id="@+id/rg10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10%"
            android:enabled="false"
            android:textSize="20dp"
            android:textColor="@color/black"
            />

    </RadioGroup>
    </LinearLayout>

    <!-- Поле для вывода скидки / итога -->

    <EditText
        android:id="@+id/etResult"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:layout_marginTop="20dp"
        android:background="#F8BBD0"
        android:focusable="false"
        android:hint="Сумма скидки"
        android:paddingHorizontal="24dp"/>

    <Button
        android:id="@+id/btResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Итого"
        android:textSize="18dp"
        android:paddingVertical="10dp"
        android:backgroundTint="#52bafa"
        android:textColor="@color/black"
        android:layout_marginTop="20dp"/>

</LinearLayout>